# Copy this file to .env and fill it in. .env is in .gitignore, so it stays on your machine.

# "fake" needs no API keys and makes no network calls to a model.
# Switch to "real" when your keys are ready.
LLM_MODE=real

# Free keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# One model per job, written as provider:model
MODEL_FAST=gemini:gemini-3.5-flash-lite
MODEL_SMART=gemini:gemini-3.8-flash
MODEL_REVIEW=groq:openai/gpt-oss-120b

# Seconds to wait between two calls to the same provider (keeps you under free limits)
GEMINI_GAP=6
GROQ_GAP=20

# Leave empty to use a local SQLite file. On Neon, paste the connection string here.
DATABASE_URL=

# How much work one run does
MAX_COMPANIES=5
MAX_POSTS=25
FIT_THRESHOLD=60
MAX_PAGES=4
MAX_REVISIONS=2

# Browser manners
BROWSER_DELAY=2
BOT_CONTACT=https://github.com/YOUR_USERNAME/founderscout
# true only on your laptop, so tests can open http://127.0.0.1
ALLOW_PRIVATE_HOSTS=true

# Approval inbox logins. User "admin" can approve; user "viewer" can only look.
ADMIN_PASSWORD=dev
VIEWER_PASSWORD=
